# MS Bauconsult - Apache-Konfiguration
# Abschnitte: Schutz der Entwicklungsdateien, saubere URLs und Weiterleitungen (Phase 3),
# Sicherheits-Header/CSP, MIME-Typen, Kompression und Caching (Phase 4, am Dateiende).

Options -Indexes
ErrorDocument 404 /index.html

<IfModule mod_dir.c>
    DirectoryIndex index.html
</IfModule>

# Schutz der Entwicklungsdateien OHNE mod_rewrite (faellt nicht offen, wenn das Modul fehlt
# oder FollowSymLinks/SymLinksIfOwnerMatch nicht erlaubt ist). Ergebnis wie die Rewrite-Regeln
# unten: 404 (mit ErrorDocument also index.html). .well-known bleibt erreichbar.
<IfModule mod_alias.c>
    RedirectMatch 404 "^/(tools|preview|screenshots|src|\.planning|\.git|\.claude)(/|$)"
    RedirectMatch 404 "^/(final\.html|build\.(sh|ps1)|tailwind\.config\.js|tailwindcss(\.exe)?|[^/]+\.md)$"
</IfModule>

# Dotfiles (.git, .env, .htaccess ...) nie ausliefern (nur Dateinamen, .well-known/ bleibt erreichbar)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # (1) http und non-www -> https://www in einem 301 (festes Ziel, kein Open Redirect)
    # Bei TLS-Terminierung vor Apache stattdessen X-Forwarded-Proto auswerten:
    # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.ms-bauconsult\.de$ [NC]
    RewriteRule ^ https://www.ms-bauconsult.de%{REQUEST_URI} [R=301,L]

    # (2) Entwicklungsmaterial nicht ausliefern
    RewriteRule ^(\.(?!well-known/)|tools(/|$)|preview(/|$)|screenshots(/|$)|src(/|$)) - [R=404,L]
    RewriteRule ^(final\.html|build\.(sh|ps1)|tailwind\.config\.js|tailwindcss(\.exe)?|[^/]+\.md)$ - [R=404,L]

    # (3) /index.html -> / (nur bei echter Anfrage, verhindert Schleife)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html[\s?]
    RewriteRule ^index\.html$ / [R=301,L]

    # (4) Rechtstexte intern als index.html ausliefern
    RewriteRule ^(impressum|datenschutz)/?$ /index.html [NC,L]
</IfModule>

# ---------------------------------------------------------------------------
# Phase 4: Sicherheits-Header, MIME-Typen, Kompression, Caching
# ---------------------------------------------------------------------------
# CSP: genau EIN Header. Setzt der Hoster zusaetzlich eine eigene CSP, gilt die Schnittmenge
# beider Header - dann die Hoster-CSP abschalten lassen (siehe LAUNCH-CHECKLIST).
# default-src 'none'      : alles, was unten nicht ausdruecklich erlaubt ist, ist verboten.
# script-src              : nur eigene Skripte plus der EINE heizreport-Widget-Pfad (wird erst nach
#                           Klick-Einwilligung geladen); kein 'unsafe-inline' (SEC-02).
# style-src 'unsafe-inline': das heizreport-Widget fuegt ein style-Element und style-Attribute per
#                           innerHTML ein; die eigene Seite hat keine Inline-Styles.
# img-src heiz.report     : Ergebnisbild des Widgets im letzten Schritt (kein data:).
# connect-src             : 'self' = sendMail.php; heizreport.de/web/ = track.php und
#                           wpCheckIntegration.php des Widgets.
# frame-src 'none'        : das Widget nutzt kein iframe.
# object-src/base-uri 'none', form-action 'self', frame-ancestors 'none': kein Plugin, keine
#                           Basis-URL-Manipulation, Formulare nur an die eigene Domain, kein Einbetten.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://heizreport.de/js/heizreport_3.js; style-src 'self' 'unsafe-inline'; img-src 'self' https://heiz.report; font-src 'self'; connect-src 'self' https://heizreport.de/web/; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    # HSTS ohne includeSubDomains: unbekannte Subdomains des Hosters (webmail., autodiscover. ...) ohne TLS
    # wuerden sonst ein Jahr gesperrt. Erstdeploy mit max-age=300 testen, dann 31536000 (LAUNCH-CHECKLIST).
    Header always set Strict-Transport-Security "max-age=31536000"
    # Gilt auch fuer sendMail.php (setzt selbst keine dieser Header, daher keine Duplikate)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Caching: HTML/PHP/robots/sitemap immer revalidieren; CSS/JS tragen ?v=-Stempel (build.sh) und
    # sind 1 Jahr immutable; Schriften und Bilder sind NICHT versioniert: 30 Tage, ohne immutable
    Header set Cache-Control "no-cache"
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff2|avif|webp|jpe?g|png)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^favicon\.svg$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddCharset utf-8 .html .css .js .svg .xml .txt
</IfModule>

# Kompression: Brotli bevorzugt, deflate als Rueckfall (jeweils eigenes IfModule)
<IfModule mod_filter.c>
    <IfModule mod_brotli.c>
        AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
    </IfModule>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
    </IfModule>
</IfModule>
